# Core - LOCAL FIRST (no Docker/k8s needed)
APP_NAME=VibeCodeTinder
ENV=development
SECRET_KEY=change-me-super-secret-key-please-32-chars-local-dev-only
API_V1_PREFIX=/api/v1

# Database - LOCAL: SQLite (zero setup), just works
DATABASE_URL=sqlite:///./vibe.db
# For Docker (postgres) uncomment below:
# DATABASE_URL=postgresql+psycopg2://vibe:vibe@postgres:5432/vibecodetinder

# Redis - LOCAL: InMemory fallback works without Redis, but if you have Redis locally:
REDIS_URL=redis://localhost:6379/0
# If no Redis installed, app auto falls back to InMemoryRedis (no setup needed)

# S3 / Media Storage - LOCAL: filesystem fallback ./storage/
# Leave empty for local dev - no S3/MinIO needed
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_MEDIA=vibe-media
S3_BUCKET_MESSAGE_MEDIA=vibe-message-media
S3_REGION=us-east-1
MEDIA_CDN_URL=http://localhost:8000/storage

# For Docker with MinIO uncomment:
# S3_ENDPOINT_URL=http://minio:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# MEDIA_CDN_URL=http://localhost:9000/vibe-media

# Security
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30

# Limits for scale targets (production tuning)
MAX_PHOTOS_PER_USER=9
MAX_MEDIA_SIZE_MB=20
MESSAGE_RATE_LIMIT_PER_MINUTE=60
SWIPE_RATE_LIMIT_PER_MINUTE=100

# Recommendation Engine
RECOMMENDATION_CANDIDATE_LIMIT=100
RECOMMENDATION_GEO_RADIUS_KM_DEFAULT=50
RECOMMENDATION_CACHE_TTL_SECONDS=300

# Frontend
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174
