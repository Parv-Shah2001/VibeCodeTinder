# Production env - 50M users scale
APP_NAME=VibeCodeTinder
ENV=production
SECRET_KEY=CHANGE_ME_32_CHARS_MIN_PROD_SECRET
API_V1_PREFIX=/api/v1

# Postgres - use RDS
DATABASE_URL=postgresql+psycopg2://vibe:STRONG_PASSWORD@prod-rds.xxx.us-east-1.rds.amazonaws.com:5432/vibecodetinder
# Connection pool tuning
# For Citus sharding:
# DATABASE_URL=postgresql+psycopg2://...?options=-c%20citus.shard_count=32

# Redis - Elasticache cluster
REDIS_URL=redis://prod-elasticache.xxx.cache.amazonaws.com:6379/0
# For cluster mode:
# REDIS_URL=redis://...:6379/0?cluster=true

# S3 - AWS production
S3_ENDPOINT_URL=
S3_ACCESS_KEY=AKIA...
S3_SECRET_KEY=...
S3_BUCKET_MEDIA=vibe-media-prod
S3_BUCKET_MESSAGE_MEDIA=vibe-message-media-prod
S3_REGION=us-east-1
MEDIA_CDN_URL=https://d123456.cloudfront.net

# Security
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30

# Scale limits
MAX_PHOTOS_PER_USER=9
MAX_MEDIA_SIZE_MB=20
MESSAGE_RATE_LIMIT_PER_MINUTE=60
SWIPE_RATE_LIMIT_PER_MINUTE=100

# Recommendation
RECOMMENDATION_CANDIDATE_LIMIT=100
RECOMMENDATION_GEO_RADIUS_KM_DEFAULT=50
RECOMMENDATION_CACHE_TTL_SECONDS=300

# Frontend
FRONTEND_URL=https://vibecodetinder.com
CORS_ORIGINS=https://vibecodetinder.com,https://www.vibecodetinder.com

# Monitoring
SENTRY_DSN=https://...@sentry.io/...
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector:4317
